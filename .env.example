# Kaonashi — environment variables. NONE is required to try the demo locally.
# On Vercel set them in Project → Settings → Environment Variables.

# --- Database --------------------------------------------------------------------------
# Neon Postgres connection string. Vercel's Neon integration fills DATABASE_URL automatically.
# Without it, local development uses an embedded Postgres (PGlite) stored in ./.data/pglite.
DATABASE_URL=
# Days of demo history generated on first boot (7–365). Default 120.
SEED_DAYS=

# --- Staff passwords (SET THESE before the first deploy of a public URL) -----------------
# Password for kaonashi_sysmaster. Required when DEMO_MODE=false.
ENV_MASTER_SEED=
# Password for the other demo staff accounts (itamae_lead, marketing_lead, ops_lead, reception_lead).
DEMO_STAFF_PASSWORD=

# --- Mode ---------------------------------------------------------------------------------
# development | staging | production. production requires real secrets below and DATABASE_URL.
APP_ENV=
# true = generated demo data + simulated Google/e-mail. Defaults to true outside production.
DEMO_MODE=

# --- Secrets (optional outside production: generated once and stored in the database) ------
SESSION_SECRET=
QR_HMAC_SECRET=
OTP_PEPPER=
WEBHOOK_HMAC_SECRET=
# Protects /api/cron/tick. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=

# --- Customer sign-in ---------------------------------------------------------------------
# Google Identity Services OAuth client id (public). Without it, demo mode shows "Google (SIMULATED)".
GOOGLE_CLIENT_ID=
# Real one-time-code e-mails — pick ONE option. Without any, demo mode shows the code in a SIMULATED mailbox
# (and production refuses e-mail sign-in).
# Option A — your Gmail (no domain needed): Gmail address + 16-character App Password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Option B — any SMTP server.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Option C — Resend (needs a verified domain to send to anyone).
RESEND_API_KEY=
EMAIL_FROM=Kaonashi <onboarding@resend.dev>
# Contact e-mail shown on the privacy policy and terms pages.
PRIVACY_CONTACT_EMAIL=

# --- Public URL / AI ------------------------------------------------------------------------
APP_BASE_URL=
ALLOWED_ORIGINS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
